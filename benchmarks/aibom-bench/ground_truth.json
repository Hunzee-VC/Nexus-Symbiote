{
  "version": "1.0",
  "notes": "Hand-authored ground truth for the corpus that build_corpus.py materializes. A component counts as detected when any match_any substring (case-insensitive) or the match_regex pattern appears in the tool's output. 'soft' items are reported but weighted at 0.5 because reasonable tools may scope them out. Class weights are in SPEC.md.",
  "classes": {
    "mcp-server": "MCP servers declared in client configuration or implemented by the project",
    "tool": "Tool definitions exposed to a model (code decorators, function schemas, MCP server tools)",
    "skill": "Agent skills (SKILL.md packages)",
    "prompt": "Instruction files, prompt templates, inline system prompts and their imports",
    "model": "Hosted or provider model references in code and configuration",
    "model-file": "Local model artifacts and their metadata",
    "dataset": "Training, evaluation and retrieval data and their pointers",
    "training": "Fine-tuning pipeline code and configuration",
    "vector-store": "Retrieval and vector databases",
    "a2a": "Agent-to-agent cards and endpoints",
    "agent-config": "IDE and CLI agent settings, permissions and hooks",
    "ci-agent": "Agents that run in CI",
    "container": "Container images referenced by the project",
    "package": "AI-relevant software dependencies",
    "guardrail": "Guardrail and evaluation configuration"
  },
  "components": [
    {
      "id": "mcp.filesystem",
      "class": "mcp-server",
      "source": [
        ".mcp.json",
        ".gemini/settings.json"
      ],
      "match_any": [
        "server-filesystem"
      ],
      "pin": "2025.8.21",
      "note": "declared twice; a precise inventory records both declarations or one component with two evidence locations",
      "match_regex": "(?i)server-filesystem|mcp[^\\n]{0,40}\\bfilesystem\\b|\\bfilesystem\\b[^\\n]{0,40}mcp"
    },
    {
      "id": "mcp.github",
      "class": "mcp-server",
      "source": [
        ".mcp.json"
      ],
      "match_any": [
        "github-mcp-server"
      ],
      "pin": "sha256:7c7f6ab9bb4a4e4e4a1d0a0c5f2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d",
      "note": "container launch, env credential",
      "match_regex": "(?i)github-mcp-server|\\bgithub\\b[^\\n]{0,30}\\(mcp|mcp[ _-]?server[^\\n]{0,30}\\bgithub\\b"
    },
    {
      "id": "mcp.postgres",
      "class": "mcp-server",
      "source": [
        ".mcp.json"
      ],
      "match_any": [
        "mcp-server-postgres"
      ],
      "note": "floating @latest; credential in URL userinfo",
      "match_regex": "(?i)mcp-server-postgres|\\bpostgres\\b[^\\n]{0,30}\\(mcp|mcp[ _-]?server[^\\n]{0,30}\\bpostgres\\b"
    },
    {
      "id": "mcp.remote-crm",
      "class": "mcp-server",
      "source": [
        ".mcp.json"
      ],
      "match_any": [
        "mcp.crm.example.com",
        "remote-crm"
      ],
      "note": "remote HTTP transport; bearer header; description carries a scanner-targeted injection"
    },
    {
      "id": "mcp.cursor-browser",
      "class": "mcp-server",
      "source": [
        ".cursor/mcp.json"
      ],
      "match_any": [
        "playwright/mcp"
      ],
      "note": "unversioned; server name carries ANSI escape sequences",
      "match_regex": "(?i)playwright/mcp|\\bbrowser\\b[^\\n]{0,30}\\(mcp|mcp[ _-]?server[^\\n]{0,30}\\bbrowser\\b"
    },
    {
      "id": "mcp.vscode-sqlite",
      "class": "mcp-server",
      "source": [
        ".vscode/mcp.json"
      ],
      "match_any": [
        "mcp-server-sqlite"
      ],
      "pin": "0.6.2",
      "note": "JSONC with comments and trailing commas",
      "match_regex": "(?i)mcp-server-sqlite|\\bsqlite\\b[^\\n]{0,30}\\(mcp|mcp[ _-]?server[^\\n]{0,30}\\bsqlite\\b"
    },
    {
      "id": "mcp.gemini-slack",
      "class": "mcp-server",
      "source": [
        ".gemini/settings.json"
      ],
      "match_any": [
        "mcp.slack.example.com"
      ],
      "note": "remote httpUrl",
      "match_regex": "(?i)mcp\\.slack\\.example\\.com|\\bslack\\b[^\\n]{0,30}\\(mcp|mcp[ _-]?server[^\\n]{0,30}\\bslack\\b"
    },
