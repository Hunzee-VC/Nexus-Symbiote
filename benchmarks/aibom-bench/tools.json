{
  "comment": "Each tool runs its documented, most complete repository-scan configuration for untrusted input (its safe mode where it documents one), offline. `default_commands` is the tool's plain documented invocation; it runs on every scenario without the `env` overrides and is used to observe default network behaviour and whether default mode executes hostile content (gates X01, X02, X09). {T} is the tools root, {scn} the writable scenario copy (also the working directory), {out} the tool's output directory.",
  "tools": {
    "nexus-symbiote": {
      "display": "Nexus SymBiote",
      "source": "https://github.com/aisecnomad/Nexus-Symbiote",
      "version": "0.2.0 (a13b622)",
      "install": "pip install <checkout> (commit under test)",
      "version_cmd": [
        "{T}/nexus/bin/nexus-symbiote",
        "--version"
      ],
      "path": [
        "{T}/nexus/bin"
      ],
      "commands": [
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "cyclonedx",
          "-o",
          "{out}/bom.cdx.json"
        ],
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "spdx",
          "-o",
          "{out}/bom.spdx.json"
        ],
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "sarif",
          "-o",
          "{out}/findings.sarif"
        ],
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "json",
          "-o",
          "{out}/native.json"
        ]
      ],
      "default_commands": [
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "-o",
          "{out}/default.json"
        ]
      ],
      "declared_scope": [
        "mcp",
        "tooldefs",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards",
        "safety"
      ]
    },
    "nexus-symbiote+shadowscan": {
      "display": "Nexus SymBiote + ShadowScan",
      "source": "https://github.com/aisecnomad/Nexus-Symbiote (docs/shadowscan-integration.md)",
      "version": "SymBiote 0.2.0 (a13b622) + ShadowScan 0.1.4 (2b80f19)",
      "install": "both, as above",
      "version_cmd": [
        "{T}/nexus/bin/nexus-symbiote",
        "--version"
      ],
      "path": [
        "{T}/nexus/bin",
        "{T}/shadowscan/bin"
      ],
      "commands": [
        [
          "sh",
          "-c",
          "shadowscan code \"$1\" --profile ci --no-incremental -f json -o \"$1/shadowscan.json\"; cp \"$1/shadowscan.json\" \"$2/shadowscan.json\" 2>/dev/null; for f in cyclonedx spdx sarif json; do case $f in cyclonedx) o=bom.cdx.json;; spdx) o=bom.spdx.json;; sarif) o=findings.sarif;; json) o=native.json;; esac; nexus-symbiote scan \"$1\" --no-project-policy --report-only -f $f -o \"$2/$o\"; done",
          "sh",
          "{scn}",
          "{out}"
        ]
      ],
      "default_commands": [
        [
          "sh",
          "-c",
          "shadowscan code \"$1\" -f json -o \"$1/shadowscan.json\"; nexus-symbiote scan \"$1\" -o \"$2/default.json\"",
          "sh",
          "{scn}",
          "{out}"
        ]
      ],
      "mode_note": "The documented merged workflow (docs/shadowscan-integration.md): ShadowScan writes shadowscan.json into the checkout and `nexus-symbiote scan` merges it with its own collectors. ShadowScan's report is kept beside the BOM as the authoritative discovery record. Nexus refuses SARIF once imported discovery is present (it cannot carry the imported coverage), so this pipeline's findings come from its native JSON and CycloneDX. The benchmark run sets SHADOWSCAN_IDENTITY_KEY (documented in ShadowScan's docs/api/engine.md; a public test key here, a CI secret in practice) so finding identities are stable across scans; without it ShadowScan keys its credential fingerprints per run and the report, and the merged BOM, differ on every scan of the same commit.",
      "declared_scope": [
        "mcp",
        "tooldefs",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards",
        "safety"
      ],
      "env": {
        "SHADOWSCAN_IDENTITY_KEY": "hex:dc5e047ea361369d05998b16c876c597fbeb8769a4fb61b532ff92f73c8c9a50"
      }
    },
    "nexus-shadowscan": {
      "display": "Nexus-ShadowScan",
      "source": "https://github.com/Hunzee-VC/nexus-shadowscan",
      "version": "0.1.4 (2b80f19)",
      "install": "pip install --require-hashes -r requirements.lock && pip install --no-deps <checkout at 2b80f19>",
      "version_cmd": [
        "{T}/shadowscan/bin/shadowscan",
        "--version"
      ],
      "path": [
        "{T}/shadowscan/bin"
      ],
      "commands": [
        [
          "shadowscan",
          "code",
          "{scn}",
          "--profile",
          "ci",
          "--no-incremental",
          "-f",
          "json",
          "-o",
          "{out}/shadowscan.json"
        ],
        [
          "shadowscan",
          "code",
          "{scn}",
          "--profile",
          "ci",
          "--no-incremental",
          "-f",
          "cyclonedx",
          "-o",
          "{out}/bom.cdx.json"
        ],
        [
          "shadowscan",
          "code",
          "{scn}",
          "--profile",
          "ci",
          "--no-incremental",
          "-f",
          "sarif",
          "-o",
          "{out}/findings.sarif"
        ]
      ],
      "default_commands": [
        [
          "shadowscan",
          "code",
          "{scn}",
          "-f",
          "json",
          "-o",
          "{out}/default.json"
        ]
      ],
      "mode_note": "The discovery half of the Nexus pipeline, graded on its own: `shadowscan code` with its CI profile and no incremental cache. Its cloud, identity, gateway and endpoint connectors are out of scope for a repository benchmark. The benchmark run sets SHADOWSCAN_IDENTITY_KEY (documented in ShadowScan's docs/api/engine.md; a public test key here, a CI secret in practice) so finding identities are stable across scans; without it ShadowScan keys its credential fingerprints per run and the report, and the merged BOM, differ on every scan of the same commit.",
      "declared_scope": [
        "mcp",
        "tooldefs",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards",
        "safety"
      ],
      "env": {
        "SHADOWSCAN_IDENTITY_KEY": "hex:dc5e047ea361369d05998b16c876c597fbeb8769a4fb61b532ff92f73c8c9a50"
      }
    },
    "cdxgen": {
      "display": "OWASP cdxgen",
      "source": "https://github.com/cdxgen/cdxgen",
      "version": "12.9.2",
      "install": "npm install --ignore-scripts @cyclonedx/cdxgen",
      "version_cmd": [
        "{T}/node/bin/node",
        "{T}/cdxgen/node_modules/@cyclonedx/cdxgen/bin/cdxgen.js",
        "--version"
      ],
      "path": [
        "{T}/cdxgen/node_modules/.bin",
        "{T}/node/bin"
      ],
      "env": {
        "CDXGEN_NO_BANNER": "true"
      },
      "commands": [
        [
          "cdxgen",
          "-r",
          "--include-formulation",
          "--no-install-deps",
          "--bom-audit",
          "--bom-audit-categories",
          "ai-bom",
          "--json-pretty",
          "-o",
          "{out}/bom.cdx.json",
          "{scn}"
        ],
        [
          "cdxgen",
          "-r",
          "--include-formulation",
          "--no-install-deps",
          "--bom-audit",
          "--bom-audit-categories",
          "ai-bom",
          "--format",
          "spdx",
          "-o",
          "{out}/bom.spdx.json",
          "{scn}"
        ]
      ],
      "default_commands": [
        [
          "cdxgen",
          "-r",
          "--include-formulation",
          "-o",
          "{out}/default.json",
          "--bom-audit",
          "--bom-audit-categories",
          "ai-bom",
          "{scn}"
        ]
      ],
      "declared_scope": [
        "mcp",
        "tooldefs",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards"
      ],
      "mode_note": "Runs the README's AI-BOM command ('Generate and audit an AI-BOM from the current repository'). The benchmark run adds the documented --no-install-deps; the plain invocation keeps cdxgen's default of installing project dependencies."
    },
