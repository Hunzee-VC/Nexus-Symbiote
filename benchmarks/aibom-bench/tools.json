{
  "comment": "Each tool runs its documented, most complete repository-scan configuration, offline. `default_commands` is the plain invocation used only to observe default network behaviour. {T} is the tools root, {scn} the scenario directory, {out} the output directory.",
  "tools": {
    "nexus-symbiote": {
      "display": "Nexus SymBiote",
      "source": "https://github.com/aisecnomad/Nexus-Symbiote",
      "version": "0.2.0 (a13b622)",
      "install": "pip install <checkout> (commit under test)",
      "version_cmd": [
        "{T}/nexus/bin/nexus-symbiote",
        "--version"
      ],
      "path": [
        "{T}/nexus/bin"
      ],
      "commands": [
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "cyclonedx",
          "-o",
          "{out}/bom.cdx.json"
        ],
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "spdx",
          "-o",
          "{out}/bom.spdx.json"
        ],
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "sarif",
          "-o",
          "{out}/findings.sarif"
        ],
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "--no-project-policy",
          "--report-only",
          "-f",
          "json",
          "-o",
          "{out}/native.json"
        ]
      ],
      "default_commands": [
        [
          "nexus-symbiote",
          "scan",
          "{scn}",
          "-o",
          "{out}/default.json"
        ]
      ],
      "declared_scope": [
        "mcp",
        "tooldefs",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards",
        "safety"
      ]
    },
    "cdxgen": {
      "display": "OWASP cdxgen (aibom)",
      "source": "https://github.com/cdxgen/cdxgen",
      "version": "12.9.2",
      "install": "npm install --ignore-scripts @cyclonedx/cdxgen",
      "version_cmd": [
        "{T}/node/bin/node",
        "{T}/cdxgen/node_modules/@cyclonedx/cdxgen/bin/cdxgen.js",
        "--version"
      ],
      "path": [
        "{T}/cdxgen/node_modules/.bin",
        "{T}/node/bin"
      ],
      "env": {
        "CDXGEN_NO_BANNER": "true"
      },
      "commands": [
        [
          "aibom",
          "-t",
          "ai",
          "-t",
          "mcp",
          "-t",
          "ai-skill",
          "-t",
          "python",
          "-t",
          "js",
          "--include-formulation",
          "--bom-audit",
          "--bom-audit-categories",
          "ai-bom",
          "--json-pretty",
          "-o",
          "{out}/bom.cdx.json",
          "{scn}"
        ],
        [
          "aibom",
          "-t",
          "ai",
          "-t",
          "mcp",
          "-t",
          "ai-skill",
          "-t",
          "python",
          "-t",
          "js",
          "--include-formulation",
          "--bom-audit",
          "--bom-audit-categories",
          "ai-bom",
          "--format",
          "spdx",
          "-o",
          "{out}/bom.spdx.json",
          "{scn}"
        ]
      ],
      "default_commands": [
        [
          "aibom",
          "-o",
          "{out}/default.json",
          "{scn}"
        ]
      ],
      "declared_scope": [
        "mcp",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards"
      ],
      "mode_note": "The aibom alias alone selects only the `ai` project type, which skips MCP configs and skills; the benchmark passes the documented types ai, mcp, ai-skill, python and js."
    },
    "syft": {
      "display": "Anchore Syft",
      "source": "https://github.com/anchore/syft",
      "version": "1.57.2",
      "install": "go install github.com/anchore/syft/cmd/syft@v1.57.2",
      "version_cmd": [
        "{T}/go/bin/syft",
        "version"
      ],
      "path": [
        "{T}/go/bin"
      ],
      "env": {
        "SYFT_CHECK_FOR_APP_UPDATE": "false"
      },
      "commands": [
        [
          "syft",
          "scan",
          "dir:{scn}",
          "-o",
          "cyclonedx-json={out}/bom.cdx.json",
          "-o",
          "spdx-json={out}/bom.spdx.json",
          "-o",
          "syft-json={out}/syft.json"
        ]
      ],
      "default_commands": [
        [
          "syft",
          "dir:{scn}",
          "-o",
          "cyclonedx-json={out}/default.json"
        ]
      ],
      "declared_scope": [
        "models",
        "packages",
        "standards"
      ]
    },
    "agent-bom": {
      "display": "agent-bom",
      "source": "https://github.com/koda-ai-studio/agent-bom",
      "version": "0.115.4",
      "install": "pip install --only-binary=:all: agent-bom==0.115.4",
      "version_cmd": [
        "{T}/agent-bom/bin/agent-bom",
        "--version"
      ],
      "path": [
        "{T}/agent-bom/bin"
      ],
      "commands": [
        [
          "agent-bom",
          "scan",
          "-p",
          "{scn}",
          "--no-discover",
          "--offline",
          "-f",
          "cyclonedx",
          "-o",
          "{out}/bom.cdx.json"
        ],
        [
          "agent-bom",
          "scan",
          "-p",
          "{scn}",
          "--no-discover",
          "--offline",
          "-f",
          "spdx",
          "-o",
          "{out}/bom.spdx.json"
        ],
        [
          "agent-bom",
          "scan",
          "-p",
          "{scn}",
          "--no-discover",
          "--offline",
          "-f",
          "sarif",
          "-o",
          "{out}/findings.sarif"
        ],
        [
          "agent-bom",
          "scan",
          "-p",
          "{scn}",
          "--no-discover",
          "--offline",
          "-f",
          "json",
          "-o",
          "{out}/native.json"
        ],
        [
          "agent-bom",
          "skills",
          "scan",
          "{scn}",
          "-f",
          "json",
          "-o",
          "{out}/skills.json"
        ]
      ],
      "default_commands": [
        [
          "agent-bom",
          "scan",
          "-p",
          "{scn}",
          "-f",
          "json",
          "-o",
          "{out}/default.json"
        ]
      ],
      "declared_scope": [
        "mcp",
        "tooldefs",
        "skills",
        "agents",
        "models",
        "data",
        "packages",
        "standards",
        "safety"
      ]
    },
    "cisco-aibom": {
      "display": "Cisco AI BOM",
      "source": "https://github.com/cisco-ai-defense/aibom",
      "version": "1.10.1",
      "install": "pip install --only-binary=:all: 'cisco-aibom[agentic,llm-openai]==1.10.1'",
      "version_cmd": [
        "{T}/cisco-aibom/bin/pip",
        "show",
        "cisco-aibom"
      ],
      "path": [
        "{T}/cisco-aibom/bin"
      ],
      "commands": [
        [
          "cisco-aibom",
          "analyze",
          "{scn}",
          "-o",
          "json",
          "-O",
          "{out}/report.json",
          "--llm-model",
          "gpt-5.4",
          "--llm-provider",
          "openai",
          "--llm-api-key",
          "dummy-not-a-key",
          "--llm-api-base",
          "http://127.0.0.1:9/v1",
          "--agentic-timeout",
          "10",
          "--agentic-batch-size",
          "50",
          "--no-show-summary",
          "--no-progress"
        ],
        [
          "cisco-aibom",
          "analyze",
          "{scn}",
          "-o",
          "cyclonedx",
          "-O",
          "{out}/bom.cdx.json",
          "--llm-model",
          "gpt-5.4",
          "--llm-provider",
          "openai",
          "--llm-api-key",
          "dummy-not-a-key",
          "--llm-api-base",
          "http://127.0.0.1:9/v1",
          "--agentic-timeout",
          "10",
          "--agentic-batch-size",
          "50",
          "--no-show-summary",
          "--no-progress"
        ],
        [
          "cisco-aibom",
          "analyze",
          "{scn}",
          "-o",
          "spdx",
          "-O",
          "{out}/bom.spdx.json",
          "--llm-model",
          "gpt-5.4",
          "--llm-provider",
          "openai",
          "--llm-api-key",
          "dummy-not-a-key",
          "--llm-api-base",
          "http://127.0.0.1:9/v1",
          "--agentic-timeout",
          "10",
          "--agentic-batch-size",
          "50",
          "--no-show-summary",
          "--no-progress"
        ],
        [
          "cisco-aibom",
          "analyze",
          "{scn}",
          "-o",
          "sarif",
          "-O",
          "{out}/findings.sarif",
          "--llm-model",
          "gpt-5.4",
          "--llm-provider",
          "openai",
          "--llm-api-key",
          "dummy-not-a-key",
          "--llm-api-base",
          "http://127.0.0.1:9/v1",
          "--agentic-timeout",
          "10",
          "--agentic-batch-size",
          "50",
          "--no-show-summary",
          "--no-progress"
        ]
      ],
      "default_commands": [
        [
          "cisco-aibom",
          "analyze",
          "{scn}",
          "-o",
          "json",
          "-O",
          "{out}/default.json",
          "--llm-model",
          "gpt-5.4",
          "--llm-api-key",
          "dummy-not-a-key"
        ]
      ],
      "declared_scope": [
        "mcp",
        "agents",
        "models",
        "data",
        "packages",
        "standards"
      ],
      "mode_note": "v1.10.1 refuses to run without an LLM. The LLM endpoint is pointed at an unreachable local port, so the tool reports its deterministic detections (pending_agent_review) and no LLM enrichment. Its intended LLM-assisted results may differ."
    },
    "ai-bom": {
      "display": "Trusera ai-bom",
      "source": "https://github.com/Trusera/ai-bom",
      "version": "3.6.0",
      "install": "pip install --only-binary=:all: ai-bom==3.6.0",
      "version_cmd": [
        "{T}/ai-bom/bin/pip",
        "show",
        "ai-bom"
      ],
      "path": [
        "{T}/ai-bom/bin"
      ],
      "commands": [
        [
          "ai-bom",
          "scan",
          "{scn}",
          "--deep",
          "--no-telemetry",
          "-f",
          "cyclonedx",
          "-o",
          "{out}/bom.cdx.json"
        ],
        [
          "ai-bom",
          "scan",
          "{scn}",
          "--deep",
          "--no-telemetry",
          "-f",
          "spdx3",
          "-o",
          "{out}/bom.spdx.json"
        ],
        [
          "ai-bom",
          "scan",
          "{scn}",
          "--deep",
          "--no-telemetry",
          "-f",
          "sarif",
          "-o",
          "{out}/findings.sarif"
        ],
        [
          "ai-bom",
          "scan",
          "{scn}",
          "--deep",
          "--no-telemetry",
          "-f",
          "json",
          "-o",
          "{out}/native.json"
        ]
      ],
      "default_commands": [
        [
          "ai-bom",
          "scan",
          "{scn}",
          "-f",
          "json",
          "-o",
          "{out}/default.json"
        ]
      ],
      "declared_scope": [
        "mcp",
        "agents",
        "models",
        "packages",
        "standards"
      ]
    },
    "aisbom": {
      "display": "AIsbom",
      "source": "https://github.com/Lab700xOrg/aisbom",
      "version": "1.7.0",
      "install": "pip install --only-binary=:all: aisbom-cli==1.7.0",
      "version_cmd": [
        "{T}/aisbom/bin/aisbom",
        "--version"
      ],
      "path": [
        "{T}/aisbom/bin"
      ],
      "commands": [
        [
          "aisbom",
          "scan",
          "{scn}",
          "--offline",
          "--no-fail-on-risk",
          "--format",
          "json",
          "--output",
          "{out}/bom.cdx.json"
        ],
        [
          "aisbom",
          "scan",
          "{scn}",
          "--offline",
          "--no-fail-on-risk",
          "--format",
          "spdx",
          "--spdx-version",
          "3.0",
          "--output",
          "{out}/bom.spdx.json"
        ]
      ],
      "default_commands": [
        [
          "aisbom",
          "scan",
          "{scn}",
          "--output",
          "{out}/default.json"
        ]
      ],
      "declared_scope": [
        "models",
        "packages",
        "standards",
        "safety"
      ]
    },
    "aibom-scanner": {
      "display": "aibom-scanner (saasvista)",
      "source": "https://github.com/saasvista/aibom-scanner",
      "version": "1.3.5",
      "install": "pip install --only-binary=:all: aibom-scanner==1.3.5",
      "version_cmd": [
        "{T}/aibom-scanner/bin/aibom-scanner",
        "--version"
      ],
      "path": [
        "{T}/aibom-scanner/bin"
      ],
      "commands": [
        [
          "aibom-scanner",
          "scan",
          "--path",
          "{scn}",
          "--format",
          "json",
          "-o",
          "{out}/report.json"
        ],
        [
          "aibom-scanner",
          "scan",
          "--path",
          "{scn}",
          "--format",
          "sarif",
          "-o",
          "{out}/findings.sarif"
        ]
      ],
      "default_commands": [
        [
          "aibom-scanner",
          "scan",
          "--path",
          "{scn}",
          "--format",
          "json",
          "-o",
          "{out}/default.json"
        ]
      ],
      "declared_scope": [
        "mcp",
        "agents",
        "models",
        "packages"
      ]
    },
    "airom": {
      "display": "AIROM",
      "source": "https://github.com/airomhq/airom",
      "version": "0.4.7",
      "install": "go install github.com/airomhq/airom/cmd/airom@v0.4.7",
      "version_cmd": [
        "{T}/go/bin/airom",
        "version"
      ],
      "path": [
        "{T}/go/bin"
      ],
      "commands": [
        [
          "airom",
          "fs",
          "{scn}",
          "--offline",
          "--auto-update-rules=false",
          "-o",
          "json={out}/airom.json",
          "-o",
          "cyclonedx={out}/bom.cdx.json",
          "-o",
          "spdx={out}/bom.spdx.json",
          "-o",
          "sarif={out}/findings.sarif"
        ]
      ],
      "default_commands": [
        [
          "airom",
          "fs",
          "{scn}",
          "-o",
          "json={out}/default.json"
        ]
      ],
      "declared_scope": [
        "models",
        "data",
        "agents",
        "packages",
        "standards"
      ]
    },
    "aibomgen-cli": {
      "display": "AIBoMGen CLI",
      "source": "https://github.com/idlab-discover/aibomgen-cli",
      "version": "0.3.0",
      "install": "go install github.com/idlab-discover/aibomgen-cli@v0.3.0",
      "version_cmd": [
        "{T}/go/bin/aibomgen-cli",
        "version"
      ],
      "path": [
        "{T}/go/bin"
      ],
      "commands": [
        [
          "aibomgen-cli",
          "scan",
          "{scn}",
          "--no-input",
          "--no-security-scan",
          "--hf-timeout",
          "5",
          "-o",
          "{out}/dist"
        ]
      ],
      "default_commands": [
        [
          "aibomgen-cli",
          "scan",
          "{scn}",
          "--no-input",
          "-o",
          "{out}/default"
        ]
      ],
      "declared_scope": [
        "models",
        "data",
        "standards"
      ]
    },
    "owasp-aibom-generator": {
      "display": "OWASP AIBOM Generator",
      "source": "https://github.com/GenAI-Security-Project/aibom-generator",
      "version": "main@2026-10-17",
      "runnable": false,
      "not_run_reason": "Takes a Hugging Face model ID and reads metadata from the live Hugging Face Hub API; it has no mode for scanning a local repository or local model files, and the Hub is unreachable from the benchmark sandbox by design.",
      "declared_scope": [
        "models",
        "standards"
      ]
    }
  }
}
