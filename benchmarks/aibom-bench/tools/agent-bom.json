{
  "tool": "agent-bom",
  "display": "agent-bom",
  "version": "0.115.4",
  "license": "Apache-2.0",
  "source": "PyPI agent-bom",
  "install": [
    "python3 -m venv {tooldir}/venv",
    "{tooldir}/venv/bin/pip install agent-bom==0.115.4"
  ],
  "bin": "{tooldir}/venv/bin/agent-bom",
  "path": [
    "{tooldir}/venv/bin"
  ],
  "env": {},
  "scans": [
    {
      "label": "native",
      "argv": [
        "{bin}",
        "scan",
        "{target}",
        "--offline",
        "--no-scan",
        "--exit-zero",
        "--model-files",
        "{target}",
        "--model-provenance",
        "--dataset-cards",
        "{target}",
        "--scan-pii",
        "--training-pipelines",
        "{target}",
        "--context-graph",
        "-f",
        "json",
        "-o",
        "{out}/report.json"
      ],
      "outputs": [
        {
          "path": "{out}/report.json",
          "format": "native-json"
        }
      ]
    },
    {
      "label": "cyclonedx",
      "argv": [
        "{bin}",
        "scan",
        "{target}",
        "--offline",
        "--no-scan",
        "--exit-zero",
        "--model-files",
        "{target}",
        "--model-provenance",
        "--dataset-cards",
        "{target}",
        "--scan-pii",
        "--training-pipelines",
        "{target}",
        "--context-graph",
        "-f",
        "cyclonedx",
        "-o",
        "{out}/bom.cdx.json"
      ],
      "outputs": [
        {
          "path": "{out}/bom.cdx.json",
          "format": "cyclonedx-json"
        }
      ]
    },
    {
      "label": "spdx3",
      "argv": [
        "{bin}",
        "scan",
        "{target}",
        "--offline",
        "--no-scan",
        "--exit-zero",
        "--model-files",
        "{target}",
        "--model-provenance",
        "--dataset-cards",
        "{target}",
        "--scan-pii",
        "--training-pipelines",
        "{target}",
        "--context-graph",
        "-f",
        "spdx",
        "-o",
        "{out}/bom.spdx3.json"
      ],
      "outputs": [
        {
          "path": "{out}/bom.spdx3.json",
          "format": "spdx-json"
        }
      ]
    },
    {
      "label": "sarif",
      "argv": [
        "{bin}",
        "scan",
        "{target}",
        "--offline",
        "--no-scan",
        "--exit-zero",
        "--model-files",
        "{target}",
        "--model-provenance",
        "--dataset-cards",
        "{target}",
        "--scan-pii",
        "--training-pipelines",
        "{target}",
        "--context-graph",
        "-f",
        "sarif",
        "-o",
        "{out}/report.sarif"
      ],
      "outputs": [
        {
          "path": "{out}/report.sarif",
          "format": "sarif"
        }
      ]
    },
    {
      "label": "html",
      "argv": [
        "{bin}",
        "scan",
        "{target}",
        "--offline",
        "--no-scan",
        "--exit-zero",
        "--model-files",
        "{target}",
        "--model-provenance",
        "--dataset-cards",
        "{target}",
        "--scan-pii",
        "--training-pipelines",
        "{target}",
        "--context-graph",
        "--offline-html",
        "-f",
        "html",
        "-o",
        "{out}/report.html"
      ],
      "outputs": [
        {
          "path": "{out}/report.html",
          "format": "html"
        }
      ]
    },
    {
      "label": "markdown",
      "argv": [
        "{bin}",
        "scan",
        "{target}",
        "--offline",
        "--no-scan",
        "--exit-zero",
        "--model-files",
        "{target}",
        "--model-provenance",
        "--dataset-cards",
        "{target}",
        "--scan-pii",
        "--training-pipelines",
        "{target}",
        "--context-graph",
        "-f",
        "markdown",
        "-o",
        "{out}/report.md"
      ],
      "outputs": [
        {
          "path": "{out}/report.md",
          "format": "markdown"
        }
      ]
    },
    {
      "label": "manifest",
      "argv": [
        "{bin}",
        "manifest",
        "-p",
        "{target}",
        "-o",
        "{out}/manifest.json"
      ],
      "outputs": [
        {
          "path": "{out}/manifest.json",
          "format": "native-json"
        }
      ]
    }
  ],
  "diff": {
    "argv": [
      "{bin}",
      "report",
      "diff",
      "{base}/report.json",
      "{drift}/report.json",
      "-f",
      "json",
      "-o",
      "{out}/diff.json"
    ]
  },
  "notes": [
    "--no-scan skips the vulnerability lookup, which needs a local database or api.osv.dev; --exit-zero keeps the gate from failing the run.",
    "--model-files, --model-provenance, --dataset-cards, --scan-pii, --training-pipelines and --context-graph enable analyses the tool documents as opt-in."
  ],
  "default": {
    "argv": [
      "{bin}",
      "scan",
      "{target}",
      "-f",
      "json",
      "-o",
      "{out}/default.json"
    ],
    "outputs": []
  },
  "default_env": {}
}
