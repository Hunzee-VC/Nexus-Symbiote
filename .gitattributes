# Normalize line endings so digests, fixtures and generated evidence compare
# identically on every platform.
* text=auto eol=lf

# Model artifacts, wheels and Sigstore bundles are byte-exact inputs: never
# convert their line endings or diff them as text.
*.safetensors binary
*.pkl binary
*.whl binary
*.sigstore binary

# Fixtures reproduce other projects' files byte for byte; the benchmark
# manifests record their SHA-256 digests. Never normalize them, and keep them
# out of the repository's language statistics.
tests/fixtures/** -text linguist-vendored
benchmarks/**/fixtures/** -text linguist-vendored

# Vendored CycloneDX and SPDX schemas are digest-bound copies of upstream files
# (SOURCES.json next to them): never normalize them.
src/nexus_symbiote/generators/schemas/vendor/** -text linguist-vendored

# The hash-locked CI requirements are generated by uv (see the file header).
# They stay diffable so dependency changes can be reviewed, but are collapsed
# by default.
requirements-ci.lock linguist-generated
