root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Test fixtures may have intentional formatting
[benchmarks/fixtures/**]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false

[tests/fixtures/**]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false

[benchmarks/inventory/fixtures/**]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false

[src/nexus_symbiote/generators/schemas/vendor/**]
charset = unset
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false
