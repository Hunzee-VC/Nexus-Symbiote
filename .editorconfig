# EditorConfig keeps whitespace consistent across editors: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonld,toml,cff}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Fixtures reproduce other projects' files byte for byte, and the benchmark
# manifests record their SHA-256 digests. Leave them exactly as committed; the
# pre-commit whitespace hooks (.pre-commit-config.yaml) exclude them too.
[tests/fixtures/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[benchmarks/fixtures/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[benchmarks/inventory/fixtures/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Vendored CycloneDX and SPDX schemas are digest-bound copies (SOURCES.json).
[src/nexus_symbiote/generators/schemas/vendor/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
